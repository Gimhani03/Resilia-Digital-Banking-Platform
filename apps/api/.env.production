# Production / enterprise profile — require Docker: `npm run db:up`
DATABASE_URL="postgresql://resilia:resilia@localhost:5432/resilia"
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET"
PORT=3001
DEMO_MODE=false
NODE_ENV=production
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
REDIS_URL=redis://localhost:6379
FEE_TRANSFER=25
FEE_TRANSFER_HIGH=50
FEE_TRANSFER_HIGH_THRESHOLD=100000
UPLOAD_DIR=./uploads
# Optional: S3_BUCKET= S3_REGION= S3_ACCESS_KEY= S3_SECRET_KEY=
# Optional: SMTP_URL= or NOTIFY_WEBHOOK_URL=
