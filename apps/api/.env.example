# Copy to apps/api/.env and adjust.
# Without Docker (SQLite emergency fallback):
DATABASE_URL="file:./dev.db"
# With Docker Postgres:
# DATABASE_URL="postgresql://resilia:resilia@localhost:5432/resilia"
# Also set prisma schema datasource provider to "postgresql"

JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
PORT=3001
DEMO_MODE=true
NODE_ENV=development
CORS_ORIGINS=*
REDIS_URL=
# REDIS_URL=redis://localhost:6379
FEE_TRANSFER=25
FEE_TRANSFER_HIGH=50
FEE_TRANSFER_HIGH_THRESHOLD=100000
UPLOAD_DIR=./uploads

NOTIFY_WEBHOOK_URL=
S3_ENDPOINT=
S3_BUCKET=resilia-kyc
S3_ACCESS_KEY=
