# Dependencies
node_modules/

# Builds & caches
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
.cache/

# Environment & secrets
# Deployed configuration comes from Key Vault via Container Apps secret
# references, never from a committed env file. .env.production was retired for
# exactly this reason — see DEPLOYMENT.md, "Secret management".
.env
.env.*
!.env.example
!**/.env.example

# Terraform — state contains generated passwords and connection strings in
# plaintext and must never be committed.
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
crash.log

# Security scan output
trivy.sarif
sbom-*.json

# Logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Expo / Metro / React Native
apps/mobile/.expo/
apps/mobile/dist/
*.jks
*.p8
*.p12
*.mobileprovision

# API local data
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
apps/api/uploads/
apps/api/ci.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Misc
*.local
.vercel
